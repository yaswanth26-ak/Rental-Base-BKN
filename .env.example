# Server
PORT=5000

# Timezone
TZ=Asia/Kolkata

# PostgreSQL (existing database: rental_booking_db)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rental_booking_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# Optional pool tuning
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
