# Server
PORT=5000
NODE_ENV=development

# Timezone
TZ=Asia/Kolkata

# PostgreSQL (set all DB_* from your environment / Render dashboard)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Optional pool tuning
DB_CONNECTION_LIMIT=10

# SSL for managed Postgres (Render). Use true in production on Render.
# Local Postgres usually: false or omit.
# If unset: enabled automatically when NODE_ENV=production (set DB_SSL=false to override).
DB_SSL=false

# JWT (never commit real secrets)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=
JWT_EXPIRES_IN=7d

# CORS — comma-separated exact frontend origins (no wildcard in production)
# Local example: http://localhost:5173
# Production example: https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173

# Swagger UI + /v3/api-docs
# Local: enabled by default (set false to disable)
# Production: disabled unless set to true
ENABLE_SWAGGER=true
